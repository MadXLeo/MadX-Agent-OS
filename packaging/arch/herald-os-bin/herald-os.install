post_install() {
  echo '==> MadX Agent OS is installed. Once per user, run:  herald-os setup'
  echo '    (it installs Hermes Agent if needed and links the bridge plugin that lets it use the system).'
  echo '    Then pick "MadX Agent OS" on the login screen, or run herald-os-app inside your desktop.'
  echo '    On Omarchy, `herald-os omarchy install` adds it to the menu, the theme and the keys.'
}

post_upgrade() {
  echo '==> MadX Agent OS updated. Restart it (or log out and back in) to use the new version.'
}
